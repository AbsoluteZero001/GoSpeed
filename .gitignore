# Compiled binaries
/bin/
/dist/
/gospeed
/gospeed.exe
*.test

# Release staging output (built EXEs and release ZIPs); never committed.
/release/

# Local diagnostic captures such as CI logs; never committed.
/tmp/

# Coverage and profiling output
coverage.out
*.prof

# Local node configuration; copy configs/nodes.example.json instead.
configs/nodes.json

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
# docs/ holds local working notes; the NET-01 field-semantics doc and the
# WAN-01 NDT7 research report are tracked deliverables. Use /docs/* (not
# /docs/) so the negation below can re-include files; Git cannot
# re-include a file whose parent directory itself is excluded.
/docs/*
!/docs/NET-01-网络诊断字段语义与限制.md
!/docs/WAN-01-A-NDT7-技术调研与PoC.md
